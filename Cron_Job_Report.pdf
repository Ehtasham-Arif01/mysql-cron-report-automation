1 0 0 1 68.3622 295.0197 cm
%PreformattedPara
0 0 0 rg
BT 1 0 0 1 10 452.9858 Tm /F5 7.191371 Tf 9.391371 TL (#!/bin/bash) Tj T* (# fetch_orders.sh) Tj T* (# Fetches the latest order records from MySQL and appends them to a report file.) Tj T* (# Every execution \(success or failure\) is logged with its date and time.) Tj T*  T* (export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin) Tj T*  T* (BASE_DIR="$\(cd "$\(dirname "$0"\)" && pwd\)") Tj T* (DB_CONFIG="$BASE_DIR/db.cnf") Tj T* (DB_NAME="company_db") Tj T* (REPORT_FILE="$BASE_DIR/orders_report.txt") Tj T* (LOG_FILE="$BASE_DIR/cron_execution.log") Tj T*  T* (MAX_RETRIES=3) Tj T* (RETRY_DELAY=10) Tj T*  T* (QUERY="SELECT order_id, customer_name, product, amount, order_time) Tj T* (    FROM orders ORDER BY order_time DESC LIMIT 10;") Tj T*  T* (now\(\) { date '+%Y-%m-%d %H:%M:%S'; }) Tj T*  T* (echo "[$\(now\)] Job started" >> "$LOG_FILE") Tj T*  T* (attempt=1) Tj T* (while [ "$attempt" -le "$MAX_RETRIES" ]; do) Tj T* (    OUTPUT=$\(mysql --defaults-extra-file="$DB_CONFIG" --table "$DB_NAME" -e "$QUERY" 2>&1\)) Tj T* (    STATUS=$?) Tj T*  T* (    if [ "$STATUS" -eq 0 ]; then) Tj T* (        {) Tj T* (            echo "==============================================") Tj T* (            echo " Report generated: $\(now\)") Tj T* (            echo "==============================================") Tj T* (            echo "$OUTPUT") Tj T* (            echo "") Tj T* (        } >> "$REPORT_FILE") Tj T* (        echo "[$\(now\)] SUCCESS: latest orders saved to $REPORT_FILE \(attempt $attempt\)" >> "$LOG_FILE") Tj T* (        exit 0) Tj T* (    fi) Tj T*  T* (    echo "[$\(now\)] WARNING: attempt $attempt/$MAX_RETRIES failed: $OUTPUT" >> "$LOG_FILE") Tj T* (    if [ "$attempt" -lt "$MAX_RETRIES" ]; then) Tj T* (        sleep "$RETRY_DELAY") Tj T* (    fi) Tj T* (    attempt=$\(\(attempt + 1\)\)) Tj T* (done) Tj T*  T* (echo "[$\(now\)] ERROR: database unavailable after $MAX_RETRIES attempts. No report written." >> "$LOG_FILE") Tj T* (exit 1) Tj T* ET
Q
q
