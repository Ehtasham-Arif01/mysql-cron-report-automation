BT 1 0 0 1 10 226.9 Tm /F5 8.5 Tf 10.7 TL (CREATE DATABASE IF NOT EXISTS company_db;) Tj T* (USE company_db;) Tj T*  T* (CREATE TABLE IF NOT EXISTS orders \() Tj T* (  order_id INT AUTO_INCREMENT PRIMARY KEY,) Tj T* (  customer_name VARCHAR\(100\) NOT NULL,) Tj T* (  product VARCHAR\(100\) NOT NULL,) Tj T* (  amount DECIMAL\(10,2\) NOT NULL,) Tj T* (  order_time DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP) Tj T* (\);) Tj T*  T* (INSERT INTO orders \(customer_name, product, amount, order_time\) VALUES) Tj T* (\('Ali Khan',     'Laptop',     950.00, NOW\(\) - INTERVAL 50 MINUTE\),) Tj T* (\('Sara Ahmed',   'Headphones',  45.50, NOW\(\) - INTERVAL 40 MINUTE\),) Tj T* (\('Usman Raza',   'Keyboard',    30.00, NOW\(\) - INTERVAL 30 MINUTE\),) Tj T* (\('Ayesha Malik', 'Monitor',    210.00, NOW\(\) - INTERVAL 20 MINUTE\),) Tj T* (\('Hassan Ali',   'Mouse',       15.99, NOW\(\) - INTERVAL 10 MINUTE\),) Tj T* (\('Zara Sheikh',  'Webcam',      60.00, NOW\(\) - INTERVAL 5 MINUTE\);) Tj T*  T* (CREATE USER IF NOT EXISTS 'report_user'@'localhost' IDENTIFIED BY 'Report@123';) Tj T* (GRANT SELECT ON company_db.orders TO 'report_user'@'localhost';) Tj T* (FLUSH PRIVILEGES;) Tj T* ET
